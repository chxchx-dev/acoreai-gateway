{
  "name": "olan-ai-gateway",
  "version": "0.1.0",
  "description": "Gateway seguro entre Olan y Ollama",
  "scripts": {
    "start": "NODE_PATH=dist node dist/src/main",
    "ios": "npx react-native run-ios",
    "android": "npx react-native run-android",
    "start:dev": "nest start --watch --builder tsc",
    "start:debug": "nest start --debug --watch --builder tsc",
    "start:dev:docker": "sh ./scripts/start-dev-docker.sh",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@prisma/client",
      "prisma",
      "@nestjs/core",
      "argon2"
    ]
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^5.0.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "cron": "^4.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.0",
    "helmet": "^7.0.0",
    "joi": "^17.0.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "mongodb": "^6.12.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.7",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/express": "^4.17.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/turndown": "^5.0.6",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
