# Desarrollo: Vite reenvía /ai al gateway. La clave se queda sólo en el servidor Vite.
VITE_AI_GATEWAY_MODE=local
VITE_AI_GATEWAY_LOCAL_URL=http://localhost:4005
VITE_AI_GATEWAY_LOCAL_KEY=replace-with-the-same-AI_GATEWAY_KEY-from-root-env

# Producción: usa un proxy inverso y no expongas una clave de gateway en VITE_*.
# VITE_AI_GATEWAY_MODE=public
# VITE_AI_GATEWAY_PUBLIC_URL=https://api.example.com
