# Desarrollo: Vite reenvía /ai al gateway. La clave solo se usa en el proxy local.
VITE_AI_GATEWAY_MODE=local
VITE_AI_GATEWAY_LOCAL_URL=http://localhost:xxxx
VITE_AI_GATEWAY_LOCAL_KEY=replace-with-the-same-AI_GATEWAY_KEY-from-root-env

# Producción: el contenedor sirve ambas áreas desde el mismo origen.
# VITE_AI_GATEWAY_MODE=public
# VITE_AI_GATEWAY_PUBLIC_URL=https://api.example.com
