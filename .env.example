# Copia este archivo como .env y sustituye todos los valores de ejemplo.
NODE_ENV=development
PORT=xxxx
LOG_LEVEL=info

# Datos y seguridad
POSTGRES_USER=template_user
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=template_ai
DATABASE_URL=postgresql://template_user:change-this-postgres-password@localhost:xxxx/template_ai?schema=public
MONGODB_URI=mongodb://localhost:xxxx/template_ai
MONGODB_DB=template_ai
MONGODB_MAX_POOL_SIZE=20
AI_GATEWAY_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ISSUER=template-ai
JWT_AUDIENCE=template-ai-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Template Administrator

# Modelos y RAG
MODEL_SERVER_URL=http://localhost:xxxx
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_NUM_THREAD=0
RAG_CHAT_MODEL=llama3.2:3b
RAG_TOP_K=6
RAG_MIN_SCORE=0.35
MAX_CONTEXT_CHUNKS=5
MAX_CHUNK_CHARS=1200
MAX_QUESTION_CHARS=1000

# Red y servicios opcionales
CORS_ORIGINS=http://localhost:xxxx,http://localhost:xxxx
REQUEST_TIMEOUT_MS=60000
TTS_SERVICE_URL=http://localhost:xxxx
STT_SERVICE_URL=http://localhost:xxxx
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Correo y recuperación de contraseña (déjalo vacío si no se usa).
SMTP_HOST=
SMTP_PORT=xxxx
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_TTL_MINUTES=15

# Automatizaciones y Knowledge Center
KNOWLEDGE_WATCHER_ALLOWED_DOMAINS=
